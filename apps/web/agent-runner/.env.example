# Generate a random secret of at least 32 characters; match apps/web/.env.local.
AGENT_RUNNER_SECRET=
# Absolute private directory on an encrypted persistent volume. Never use your
# personal ~/.codex; Codex creates a separate account store per Tidy user here.
AGENT_RUNTIME_DIRECTORY=/var/lib/tidy-codex
AGENT_TIDY_URL=http://localhost:3000
AGENT_RUNNER_HOST=127.0.0.1
AGENT_RUNNER_PORT=8790
