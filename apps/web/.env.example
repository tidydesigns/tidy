# Browser collection defaults off. Enabling it still requires each user's consent.
NEXT_PUBLIC_POSTHOG_ENABLED=0
# Copy to apps/web/.env.local for local development. Keep actual secrets out of Git.
# Shared project token for separately controlled browser collection, server errors
# and server-only global functional flags. Flag evaluation does not use browser consent
# or NEXT_PUBLIC_POSTHOG_ENABLED; unset the project token/host to disable evaluation.
NEXT_PUBLIC_POSTHOG_KEY=
# Set at build time as well as in the Worker. Accepts the regional ingestion host
# or https://t.tidydesign.co; browser traffic passes through the consent-gated /api/t.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_SURVEY_ID=
# Build-only source-map upload credentials. Never add these to NEXT_PUBLIC_*.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# Build-only uploads also require either browser collection or server errors to be enabled.
POSTHOG_UPLOAD_SOURCEMAPS=
# Optional release override; otherwise uses the Git commit being built.
NEXT_PUBLIC_APP_VERSION=
# Core server faults only: no cookies, account identity, replay or browser events.
# Independent deployment switch; defaults off.
POSTHOG_SERVER_ERRORS_ENABLED=0
# Optional MCP metrics; requires the MCP consent migration and an account opt-in.
POSTHOG_MCP_ANALYTICS_ENABLED=0
# Tracing also requires the release switch and request diagnostics consent.
POSTHOG_TRACING_ENABLED=0

BETTER_AUTH_URL=http://localhost:3000
# Website hosting the canonical privacy notice. Public, build-time configuration.
# For local review, point this to the local website server.
NEXT_PUBLIC_SITE_URL=https://tidydesign.co
BETTER_AUTH_SECRET=
# Optional sign-in providers. Use dedicated OAuth clients for each environment.
# Callbacks: /api/auth/callback/google and /api/auth/callback/github on BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Local Postgres from the repository's compose.yaml.
DATABASE_URL=postgresql://bellarun:bellarun_local@127.0.0.1:55432/bellarun_dev
# Maximum connections per Node.js process; Workers use request-scoped Hyperdrive pools.
DATABASE_POOL_MAX=5
# Cloudflare Email Sending: account ID, token with Email Sending: Edit, and a sender on an onboarded domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# A plain address or display name and address, e.g. Tidy <accounts@example.com>.
AUTH_EMAIL_FROM=
# Base64-encoded 32-byte key. Preserve the key for an existing database.
VAULT_ENCRYPTION_KEY=

# Stripe Pro billing. Configure a $10 USD monthly recurring Price
# and a once-only 50% (or $5 USD) first-month coupon.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FIRST_MONTH_COUPON_ID=

# Shared development GitHub App. Optional unless testing GitHub locally.
# Register http://localhost:3000/api/github/callback on the development app.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_SECRET=
# Quoted PEM with escaped \n separators, or a quoted multiline PEM.
GITHUB_PRIVATE_KEY=
# Match the development app's webhook secret.
GITHUB_WEBHOOK_SECRET=

# Linear OAuth application. Callback: http://localhost:3000/api/linear/callback
# Configure the same credentials as runtime secrets on the deployed Worker.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Verified account emails allowed to read customer feedback screenshots.
FEEDBACK_REVIEWER_EMAILS=

# Native Codex threads: disabled until the local schema and runner are ready.
TIDY_AGENTS_ENABLED=false
AGENT_MODEL=
AGENT_RUNNER_URL=http://127.0.0.1:8790
# Generate an independent random secret with at least 32 characters; same on runner.
AGENT_RUNNER_SECRET=

# Account privacy; configure production values in private Worker bindings.
PRIVACY_CLEANUP_SECRET=
PRIVACY_POSTHOG_HOST=
PRIVACY_POSTHOG_PROJECT_ID=
PRIVACY_POSTHOG_API_KEY=
# Set to 1 only for installations that have never stored PostHog data.
PRIVACY_POSTHOG_DISABLED=0
# Manual erasure: inspect and complete jobs with scripts/privacy-posthog-review.ts.
# Omit or use api to submit configured provider requests (completion still requires review).
PRIVACY_POSTHOG_MODE=manual

# Independent product access; never require optional analytics consent for Vault.
VAULT_ENABLED=0
