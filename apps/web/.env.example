# Copy to apps/web/.env.local for local development. Keep actual secrets out of Git.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_SURVEY_ID=
# Build-only source-map upload credentials. Never add these to NEXT_PUBLIC_*.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# Set to 1 for release builds; requires POSTHOG_API_KEY. Local builds leave unset.
POSTHOG_UPLOAD_SOURCEMAPS=
# Optional release override; otherwise uses the Git commit being built.
NEXT_PUBLIC_APP_VERSION=
# Server tracing uses the same project key/host. Enabled by default; 0 opts out.
POSTHOG_TRACING_ENABLED=1

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional sign-in providers. Use dedicated OAuth clients for each environment.
# Callbacks: /api/auth/callback/google and /api/auth/callback/github on BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Local Postgres from the repository's compose.yaml.
DATABASE_URL=postgresql://bellarun:bellarun_local@127.0.0.1:55432/bellarun_dev
# Maximum connections per Node.js process; Workers use request-scoped Hyperdrive pools.
DATABASE_POOL_MAX=5
# Cloudflare Email Sending: account ID, token with Email Sending: Edit, and a sender on an onboarded domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# A plain address or display name and address, e.g. Tidy <accounts@example.com>.
AUTH_EMAIL_FROM=
# Base64-encoded 32-byte key. Preserve the key for an existing database.
VAULT_ENCRYPTION_KEY=

# Stripe Pro billing. Configure a $10 USD monthly recurring Price
# and a once-only 50% (or $5 USD) first-month coupon.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FIRST_MONTH_COUPON_ID=

# Shared development GitHub App. Optional unless testing GitHub locally.
# Register http://localhost:3000/api/github/callback on the development app.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_SECRET=
# Quoted PEM with escaped \n separators, or a quoted multiline PEM.
GITHUB_PRIVATE_KEY=
# Match the development app's webhook secret.
GITHUB_WEBHOOK_SECRET=

# Linear OAuth application. Callback: http://localhost:3000/api/linear/callback
# Configure the same credentials as runtime secrets on the deployed Worker.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Verified account emails allowed to read customer feedback screenshots.
FEEDBACK_REVIEWER_EMAILS=

# Native Codex threads: disabled until the local schema and runner are ready.
TIDY_AGENTS_ENABLED=false
AGENT_MODEL=
AGENT_RUNNER_URL=http://127.0.0.1:8790
# Generate an independent random secret with at least 32 characters; same on runner.
AGENT_RUNNER_SECRET=
