{
  "name": "@tidy/desktop",
  "version": "0.1.0",
  "description": "Tidy desktop application",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "bun run build && bun scripts/package.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint .",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@tidy/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4"
  }
}
