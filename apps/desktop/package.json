{
  "name": "@tidy/desktop",
  "version": "0.1.0-beta.1",
  "desktopBuildNumber": "1",
  "description": "Tidy desktop application",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run build:host && electron-vite dev",
    "build": "bun run build:host && electron-vite build",
    "start": "electron-vite preview",
    "package": "bun run build && bun scripts/package.ts",
    "typecheck": "tsrs --noEmit -p tsconfig.node.json && tsrs --noEmit -p tsconfig.renderer.json && tsrs --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "bun test src",
    "test:threads": "bun run build && bun scripts/thread-loading-smoke.ts",
    "test:security": "env -u ELECTRON_RUN_AS_NODE electron scripts/security-smoke.mjs && env -u ELECTRON_RUN_AS_NODE electron scripts/update-lifecycle-smoke.mjs",
    "postinstall": "install-electron",
    "dev:browser": "node --import tsx scripts/dev-browser.ts",
    "release:mac": "bun run build && bun scripts/release-mac.ts",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.test.json",
    "build:host": "bun scripts/build-host.ts",
    "host": "node --import tsx scripts/host.ts",
    "test:browser": "bun run build && node --import tsx --test src/main/browser/browser-service.test.ts src/main/browser/download-archive.test.ts && bun scripts/test-browser.ts",
    "test:remote": "bun run build && bun scripts/test-remote.ts",
    "build:demo": "vite build --config website-demo.vite.config.ts",
    "test:terminal": "bun run build && env -u ELECTRON_RUN_AS_NODE electron scripts/terminal-smoke.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@puppeteer/browsers": "3.2.6",
    "@tidy/design": "workspace:*",
    "@tidy/design-renderer": "workspace:*",
    "@tidy/editor": "workspace:*",
    "@tidy/ui": "workspace:*",
    "ghostty-web": "0.4.0",
    "puppeteer-core": "25.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.35.0",
    "ws": "8.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.14",
    "@types/mdast": "4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.1",
    "electron-vite": "^6.0.0",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "@types/ws": "8.18.1"
  }
}
