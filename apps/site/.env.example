NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Public repository URL shown by the site.
# GitHub URLs also show a live star count, refreshed in the browser every five minutes.
NEXT_PUBLIC_REPOSITORY_URL=

# Optional override. The default /download/mac resolves the latest published beta.
NEXT_PUBLIC_DOWNLOAD_URL=
# Server-only public GitHub repository for desktop beta releases.
DESKTOP_RELEASE_REPOSITORY=tidydesigns/tidy
# Optional locally; required as a server-only Worker secret in production. Never use NEXT_PUBLIC_.
GITHUB_RELEASES_TOKEN=
