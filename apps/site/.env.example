NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Use the same project token/region as the app: tidy-prod in production, tidy-dev locally.
# Optional collection stays off until enabled and the visitor has consented.
NEXT_PUBLIC_POSTHOG_ENABLED=0
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Runtime Worker variable, also used locally. Explicitly set the app origin that
# provides consent receipts and the existing consent-gated ingestion endpoint.
ANALYTICS_APP_ORIGIN=http://localhost:3000
# Optional local preview port for concurrent worktrees.
PORT=3001
# Public repository URL shown by the site.
# GitHub URLs also show a live star count, refreshed in the browser every five minutes.
NEXT_PUBLIC_REPOSITORY_URL=

# Optional override. The default /download/mac resolves the latest published beta.
NEXT_PUBLIC_DOWNLOAD_URL=
# Server-only public GitHub repository for desktop beta releases.
DESKTOP_RELEASE_REPOSITORY=tidydesigns/tidy
# Optional locally; required as a server-only Worker secret in production. Never use NEXT_PUBLIC_.
GITHUB_RELEASES_TOKEN=
