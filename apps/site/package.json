{
  "name": "@tidy/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-desktop-demo.mjs && bun scripts/dev.mjs",
    "build": "node scripts/copy-desktop-demo.mjs && next build && bun scripts/finalize-blog-export.ts",
    "demo:update": "node scripts/update-desktop-demo.mjs",
    "deploy": "bun scripts/deploy.mjs",
    "preview": "wrangler preview",
    "lint": "eslint",
    "typecheck": "next typegen && tsrs --noEmit",
    "typecheck:tsc": "next typegen && tsc --noEmit",
    "test": "bun test lib/blog.test.ts scripts/build-blog-image.test.mjs scripts/copy-desktop-demo.test.mjs"
  },
  "dependencies": {
    "@tidy/ui": "workspace:*",
    "gray-matter": "4.0.3",
    "next": "16.4.2",
    "posthog-js": "^1.445.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "0.35.5",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
