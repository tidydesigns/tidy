{
  "name": "@tidy/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd ../desktop build:demo && node scripts/copy-desktop-demo.mjs && next dev --port 3001",
    "build": "node scripts/copy-desktop-demo.mjs && next build",
    "deploy": "bun scripts/deploy.mjs",
    "preview": "wrangler preview",
    "lint": "eslint",
    "typecheck": "next typegen && tsrs --noEmit",
    "typecheck:tsc": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@tidy/ui": "workspace:*",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "0.35.5",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
