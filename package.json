{
  "name": "bella",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@bella/web",
    "dev:site": "turbo run dev --filter=@tidy/site",
    "dev:extension": "turbo run dev --filter=@bella/extension",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@bella/web",
    "build:site": "turbo run build --filter=@tidy/site",
    "build:extension": "turbo run build --filter=@bella/extension",
    "build:worker": "bun run --cwd apps/web build:worker",
    "deploy:worker": "bun run --cwd apps/web deploy:worker",
    "preview:worker": "bun run --cwd apps/web preview:worker",
    "preview:local": "bun run --cwd apps/web preview:local",
    "start": "bun run --cwd apps/web start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run format:check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:plans": "node apps/web/scripts/test-account-controls.mjs --plans",
    "billing:pro": "bun apps/web/scripts/billing-pro.ts",
    "test:account-controls": "node apps/web/scripts/test-account-controls.mjs",
    "test:auth": "node apps/web/scripts/test-account-controls.mjs --auth",
    "test:auth:browser": "node apps/web/scripts/test-auth-browser.mjs",
    "test:agents:browser": "node apps/web/scripts/test-agents-browser.mjs",
    "test:agents": "node apps/web/scripts/test-account-controls.mjs --agents",
    "agents:runner": "bun --env-file=apps/web/agent-runner/.env.local apps/web/agent-runner/main.ts",
    "test:auth-worker": "bun apps/web/scripts/test-auth-worker.mjs",
    "zip:extension": "bun run --cwd apps/extension zip",
    "dev:realtime": "bun run --cwd apps/web dev:realtime",
    "test:multiplayer": "bun run --cwd apps/web test:multiplayer",
    "test:multiplayer:browser": "bun run --cwd apps/web test:multiplayer:browser",
    "types:worker": "bun run --cwd apps/web types:worker",
    "build:gpt-plugin": "turbo run build --filter=@tidy/gpt-plugin",
    "dev:gpt-plugin": "bun run --cwd apps/gpt-plugin dev",
    "zip:gpt-plugin": "bun run --cwd apps/gpt-plugin zip",
    "test:runtime:db": "node apps/web/scripts/test-account-controls.mjs --runtime",
    "test:clipboard:db": "node apps/web/scripts/test-account-controls.mjs --clipboard",
    "test:personal:db": "node apps/web/scripts/test-account-controls.mjs --personal",
    "test:mcp:db": "node apps/web/scripts/test-account-controls.mjs --mcp",
    "test:linear:db": "node apps/web/scripts/test-account-controls.mjs --linear",
    "test:files:db": "node apps/web/scripts/test-account-controls.mjs --files",
    "test:versions:db": "node apps/web/scripts/test-account-controls.mjs --versions",
    "test:images:db": "node apps/web/scripts/test-account-controls.mjs --images",
    "test:storage:db": "node apps/web/scripts/test-account-controls.mjs --storage",
    "test:multiplayer:db": "node apps/web/scripts/test-account-controls.mjs --multiplayer",
    "export:source": "node scripts/export-source.mjs",
    "check:public-source": "node scripts/public-source.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "test:request-worker": "bun apps/web/scripts/test-request-worker.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "turbo": "^2.8.20"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "source-map-js": "1.2.2"
  },
  "patchedDependencies": {
    "@better-auth/oauth-provider@1.7.7": "patches/@better-auth%2Foauth-provider@1.7.7.patch",
    "paper@0.12.18": "patches/paper@0.12.18.patch"
  },
  "version": "0.1.0"
}
