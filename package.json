{
  "name": "tidy",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@tidy/web",
    "dev:site": "turbo run dev --filter=@tidy/site",
    "dev:extension": "turbo run dev --filter=@tidy/extension",
    "dev:desktop": "turbo run dev --filter=@tidy/desktop",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@tidy/web",
    "build:site": "turbo run build --filter=@tidy/site",
    "build:extension": "turbo run build --filter=@tidy/extension",
    "build:desktop": "turbo run build --filter=@tidy/desktop",
    "start:desktop": "bun run --cwd apps/desktop start",
    "package:desktop": "bun run --cwd apps/desktop package",
    "build:worker": "bun run --cwd apps/web build:worker",
    "deploy:worker": "bun run --cwd apps/web deploy:worker",
    "preview:worker": "bun run --cwd apps/web preview:worker",
    "preview:local": "bun run --cwd apps/web preview:local",
    "start": "bun run --cwd apps/web start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run format:check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:plans": "node apps/web/scripts/test-account-controls.mjs --plans",
    "billing:pro": "bun apps/web/scripts/billing-pro.ts",
    "test:account-controls": "node apps/web/scripts/test-account-controls.mjs",
    "test:auth": "node apps/web/scripts/test-account-controls.mjs --auth",
    "test:auth:browser": "node apps/web/scripts/test-auth-browser.mjs",
    "test:agents:browser": "node apps/web/scripts/test-agents-browser.mjs",
    "test:agents": "node apps/web/scripts/test-account-controls.mjs --agents",
    "agents:runner": "bun --env-file=apps/web/agent-runner/.env.local apps/web/agent-runner/main.ts",
    "test:auth-worker": "node apps/web/scripts/test-auth-context-worker.mjs && node apps/web/scripts/test-auth-worker.mjs",
    "zip:extension": "bun run --cwd apps/extension zip",
    "dev:realtime": "bun run --cwd apps/web dev:realtime",
    "test:multiplayer": "bun run --cwd apps/web test:multiplayer",
    "test:multiplayer:browser": "bun run --cwd apps/web test:multiplayer:browser",
    "types:worker": "bun run --cwd apps/web types:worker",
    "build:gpt-plugin": "turbo run build --filter=@tidy/gpt-plugin",
    "dev:gpt-plugin": "bun run --cwd apps/gpt-plugin dev",
    "zip:gpt-plugin": "bun run --cwd apps/gpt-plugin zip",
    "test:runtime:db": "node apps/web/scripts/test-account-controls.mjs --runtime",
    "test:clipboard:db": "node apps/web/scripts/test-account-controls.mjs --clipboard",
    "test:personal:db": "node apps/web/scripts/test-account-controls.mjs --personal",
    "test:mcp:db": "node apps/web/scripts/test-account-controls.mjs --mcp",
    "bench:mcp": "node apps/web/scripts/test-account-controls.mjs --mcp-benchmark",
    "test:linear:db": "node apps/web/scripts/test-account-controls.mjs --linear",
    "test:extension:db": "node apps/web/scripts/test-account-controls.mjs --extension",
    "test:files:db": "node apps/web/scripts/test-account-controls.mjs --files",
    "test:versions:db": "node apps/web/scripts/test-account-controls.mjs --versions",
    "test:images:db": "node apps/web/scripts/test-account-controls.mjs --images",
    "test:storage:db": "node apps/web/scripts/test-account-controls.mjs --storage",
    "test:multiplayer:db": "node apps/web/scripts/test-account-controls.mjs --multiplayer",
    "export:source": "node scripts/export-source.mjs",
    "check:public-source": "node scripts/public-source.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "test:request-worker": "node apps/web/scripts/test-request-worker.mjs",
    "test:privacy:db": "node apps/web/scripts/test-account-controls.mjs --privacy",
    "test:figma:browser": "bun apps/web/scripts/test-figma-browser.ts",
    "test:figma:publication:browser": "node apps/web/scripts/test-figma-publication-browser.ts",
    "test:telemetry-worker": "node apps/web/scripts/test-telemetry-worker.mjs",
    "test:worker-source-maps": "node apps/web/scripts/test-worker-source-maps.mjs",
    "test:browser": "bun run --cwd apps/web test:browser",
    "test:browser:install": "bun run --cwd apps/web browser:install",
    "test:navigation:recovery": "NAVIGATION_RECOVERY=1 node apps/web/scripts/test-navigation-browser.mjs",
    "test:prototypes:local": "bun apps/web/scripts/run-prototype-browser.ts",
    "test:versions:local": "bun apps/web/scripts/run-file-version-history.ts",
    "test:acceptance:local": "bun apps/web/scripts/run-authenticated-editor-acceptance.ts",
    "dev:desktop:browser": "bun run --cwd apps/desktop dev:browser",
    "release:desktop:mac": "bun run --cwd apps/desktop release:mac",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "test:analytics:db": "node apps/web/scripts/test-account-controls.mjs --analytics"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "^2.8.20"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "dompurify": "3.4.17",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.7",
    "body-parser": "2.4.0",
    "qs": "6.16.1",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "glob": "13.0.6"
  },
  "patchedDependencies": {
    "@better-auth/oauth-provider@1.7.7": "patches/@better-auth%2Foauth-provider@1.7.7.patch",
    "paper@0.12.18": "patches/paper@0.12.18.patch",
    "@better-auth/core@1.7.7": "patches/@better-auth%2Fcore@1.7.7.patch",
    "pg@8.23.0": "patches/pg@8.23.0.patch",
    "zod@4.6.7": "patches/zod@4.6.7.patch"
  },
  "version": "0.1.0"
}
