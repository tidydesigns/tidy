{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["LICENSE", "licenses/bundled/**", "scripts/bundle-licenses.ts"],
  "globalPassThroughEnv": ["NODE_OPTIONS", "TIDY_CLOUD_URL"],
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "VAULT_ENCRYPTION_KEY",
    "BELLA_EXTENSION_IDS",
    "WXT_BELLA_URL",
    "GITHUB_*",
    "LINEAR_*",
    "BELLA_REALTIME_URL"
  ],
  "tasks": {
    "build": {
      "env": ["POSTHOG_TRACING_ENABLED"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "out/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@tidy/web#typecheck": {
      "dependsOn": ["^typecheck", "@tidy/gpt-plugin#build"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "@tidy/extension#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".wxt/**"]
    },
    "@tidy/gpt-plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@tidy/web#test": {
      "dependsOn": ["^test", "@tidy/gpt-plugin#build"]
    },
    "@tidy/web#dev": {
      "dependsOn": ["@tidy/gpt-plugin#build"],
      "cache": false,
      "persistent": true
    },
    "@tidy/site#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DESKTOP_RELEASE_REPOSITORY", "GITHUB_RELEASES_TOKEN"]
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"]
    },
    "@tidy/web#typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc", "@tidy/gpt-plugin#build"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "@tidy/extension#typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": [".wxt/**"]
    },
    "@tidy/desktop#build:demo": {
      "dependsOn": ["^build"],
      "outputs": ["demo-dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bundle-licenses.ts",
        "$TURBO_ROOT$/licenses/bundled/**",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/packages/editor/src/**",
        "$TURBO_ROOT$/packages/editor/*.css",
        "$TURBO_ROOT$/packages/design/*.ts",
        "$TURBO_ROOT$/packages/design-renderer/*.ts",
        "$TURBO_ROOT$/packages/design-renderer/*.tsx",
        "$TURBO_ROOT$/packages/ui/*.tsx",
        "$TURBO_ROOT$/packages/ui/*.ts",
        "$TURBO_ROOT$/packages/{editor,design,design-renderer,ui}/package.json",
        "$TURBO_ROOT$/packages/ui/*.css",
        "$TURBO_ROOT$/packages/ui/fonts/**",
        "$TURBO_ROOT$/packages/ui/harness-icons/**"
      ]
    },
    "@tidy/site#build": {
      "dependsOn": ["^build", "@tidy/desktop#build:demo"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "public/desktop-demo/**"
      ]
    }
  }
}
