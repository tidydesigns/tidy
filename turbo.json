{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["LICENSE", "licenses/bundled/**", "scripts/bundle-licenses.ts"],
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "VAULT_ENCRYPTION_KEY",
    "BELLA_EXTENSION_IDS",
    "WXT_BELLA_URL",
    "GITHUB_*",
    "LINEAR_*",
    "BELLA_REALTIME_URL"
  ],
  "tasks": {
    "build": {
      "env": ["POSTHOG_TRACING_ENABLED"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "out/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@tidy/web#typecheck": {
      "dependsOn": ["^typecheck", "@tidy/gpt-plugin#build"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "@tidy/extension#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".wxt/**"]
    },
    "@tidy/gpt-plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@tidy/web#test": {
      "dependsOn": ["^test", "@tidy/gpt-plugin#build"]
    },
    "@tidy/web#dev": {
      "dependsOn": ["@tidy/gpt-plugin#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"]
    },
    "@tidy/web#typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc", "@tidy/gpt-plugin#build"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "@tidy/extension#typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": [".wxt/**"]
    }
  }
}
